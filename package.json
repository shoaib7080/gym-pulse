{
  "name": "gympulse",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @gympulse/shared build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @gympulse/shared build && pnpm --filter api dev",
    "dev:web": "pnpm --filter @gympulse/shared build && pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter api test"
  }
}
