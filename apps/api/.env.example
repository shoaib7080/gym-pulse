# Hosted PostgreSQL development database (synthetic data only).
# Keep ?sslmode=require at the end for hosted databases.
# Safety rule: development/test database name MUST match /(dev|test|local|scratch)/i
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gympulse_dev?sslmode=require
PORT=3000
NODE_ENV=development

# Database Safety Rails
ALLOW_DB_RESET=false
ALLOW_DESTRUCTIVE_TESTS=false

# Platform Admin Provisioning (Seed)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=your-secure-admin-password
ALLOW_PROD_SEED=false

# Better Auth Configuration
BETTER_AUTH_SECRET=your-32-char-random-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Application Encryption Key for sensitive secrets (AES-256-GCM 32-byte hex string)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Platform Payment Provider Master Keys (Secrets Manager)
TAP_SECRET_KEY=sk_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
